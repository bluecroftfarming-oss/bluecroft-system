# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# data/seed/bluecroft.seed.db is intentionally NOT ignored (one dir deeper
# than the pattern above reaches) — it's the migrated-data snapshot baked
# into the Docker image so a fresh deploy boots with real inventory instead
# of an empty database.
